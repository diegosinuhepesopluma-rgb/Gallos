name: Compilar GalloGiro

on:
  workflow_dispatch:
  push:
    branches:
      - main

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Descargar archivos
        uses: actions/checkout@v4

      - name: Configurar Java 21
        uses: actions/setup-java@v5
        with:
          distribution: temurin
          java-version: "21"

      - name: Configurar Gradle
        uses: gradle/actions/setup-gradle@v6
        with:
          gradle-version: "8.12.1"
          cache-disabled: true

      - name: Preparar proyecto NeoForge
        shell: bash
        run: |
          set -e
          rm -rf proyecto contenedor
          mkdir -p contenedor proyecto

          JAR=$(find . -maxdepth 2 -type f -name '*.jar' -print -quit)
          if [ -z "$JAR" ]; then
            echo "ERROR: No se encontró el archivo .jar del proyecto."
            exit 1
          fi

          echo "Archivo encontrado: $JAR"
          unzip -q "$JAR" -d contenedor

          ZIP=$(find contenedor -type f -name '*.zip' -print -quit)
          if [ -z "$ZIP" ]; then
            echo "ERROR: No se encontró el proyecto fuente .zip dentro del archivo."
            find contenedor -maxdepth 4 -type f | sort
            exit 1
          fi

          unzip -q "$ZIP" -d proyecto

          GRADLE=$(find proyecto -type f -name 'build.gradle' -print -quit)
          if [ -z "$GRADLE" ]; then
            echo "ERROR: No se encontró build.gradle."
            find proyecto -maxdepth 5 -type f | sort
            exit 1
          fi

          PROJECT_DIR=$(dirname "$GRADLE")
          echo "PROJECT_DIR=$PROJECT_DIR" >> "$GITHUB_ENV"
          echo "Proyecto listo en: $PROJECT_DIR"

      - name: Compilar mod NeoForge 1.21.1
        working-directory: ${{ env.PROJECT_DIR }}
        run: gradle clean build --no-daemon --stacktrace

      - name: Guardar JAR
        uses: actions/upload-artifact@v4
        with:
          name: GalloGiro-NeoForge-1.21.1
          path: ${{ env.PROJECT_DIR }}/build/libs/*.jar
          if-no-files-found: error
